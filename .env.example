# ==========================================
# GAMESBOY.NET - ENVIRONMENT TEMPLATE
# ==========================================
PORT=3000
NODE_ENV=production
HOST=0.0.0.0
APP_NAME=GamesBoy
APP_DOMAIN=gamesboy.net
APP_URL=https://gamesboy.net

# CORS Configuration
CORS_ORIGIN=*

# Dedicated Database Configuration (Railway PostgreSQL)
# Connects to Railway native PostgreSQL via ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@host:port/railway
DB_SSL=true

# Security & Authentication
JWT_SECRET=gamesboy_jwt_secret_replace_in_production
SESSION_SECRET=gamesboy_session_secret_replace_in_production

# Platform Defaults
PLATFORM_COMMISSION_PCT=10.0
DEFAULT_EXCHANGE_RATE_PYG=7800
