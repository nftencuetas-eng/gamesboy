# ==========================================
# GAMESBOY.NET - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Settings
PORT=3000
NODE_ENV=development
HOST=0.0.0.0
APP_NAME=GamesBoy
APP_DOMAIN=gamesboy.net
APP_URL=http://localhost:3000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://gamesboy.net,https://www.gamesboy.net

# Database Configuration
# Supported types: postgresql | mysql | memory
DB_TYPE=postgresql

# Direct Connection String (PostgreSQL or MySQL)
# Example PostgreSQL: postgresql://username:password@localhost:5432/gamesboy_db
# Example MySQL: mysql://username:password@localhost:3306/gamesboy_db
DATABASE_URL=

# Or Individual DB parameters (used if DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gamesboy_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Security & Sessions
JWT_SECRET=super-secret-gamesboy-key-change-this-in-production
SESSION_SECRET=gamesboy-session-secret-key-xyz
